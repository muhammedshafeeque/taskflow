PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pa
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=ml
# Optional override for Support Engineer / QA Lead / Chat Analyzer
SUPPORT_CHAT_MODEL=

# Taskflow — TASKFLOW_INGEST_SECRET = server PA_INGEST_SECRET
# Used for: CRM leads, Groups project list, Service Desk tickets, project context.
TASKFLOW_API_URL=http://127.0.0.1:5000
TASKFLOW_INGEST_SECRET=
TASKFLOW_ORG_ID=
# Optional: JWT for fuller Atrium dashboard snapshot (not needed for Groups/Support).
TASKFLOW_API_TOKEN=
TASKFLOW_EMAIL=
TASKFLOW_PASSWORD=

# Control center
PA_ADMIN_SECRET=
CONTROL_CENTER_ORIGIN=http://localhost:5174
