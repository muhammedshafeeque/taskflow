PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pa
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Strong model: QA tickets, polished customer replies, hard DMs
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Fast/cheap model: triage, SE decide JSON, reply critic, uncertain DM classify
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=ml
# Optional overrides
SUPPORT_CHAT_MODEL=
SUPPORT_STRONG_MODEL=
SUPPORT_FAST_MODEL=
# Fail fast on slow Groq calls (SDK retries 429/5xx twice)
GROQ_TIMEOUT_MS=30000

# WhatsApp bot tuning
# Quiet window to merge a message burst into one reply, and max hold time
BOT_BATCH_WINDOW_MS=1200
BOT_BATCH_MAX_WAIT_MS=4000
# Chats processed in parallel (protects Groq rate limits)
BOT_MAX_CONCURRENT_CHATS=4
# Ignore backlog older than this after reconnects (0 = never skip)
BOT_MAX_MESSAGE_AGE_SEC=600
# Show "typing…"/"recording…" and mark chats read while working
BOT_TYPING_INDICATOR=true

# Taskflow — TASKFLOW_INGEST_SECRET = server PA_INGEST_SECRET (legacy ingest)
# Used for: CRM leads, Groups project list, Service Desk tickets, project context,
# portal service-request approve/reject via Control Center.
TASKFLOW_API_URL=http://127.0.0.1:5000
TASKFLOW_INGEST_SECRET=
TASKFLOW_ORG_ID=
TASKFLOW_TIMEOUT_MS=8000
# Client-scoped WhatsApp API (docs, KB, tickets for a chat). Same value as server ATRIUM_INTERNAL_SECRET (≥32 chars).
ATRIUM_INTERNAL_SECRET=
# JWT auth — REQUIRED for the PA assistant (mobile "Ask PA" / voice) to read and update Atrium data
# (issues, sprints, CRM, service desk, calendar, monitor, HRMS). Not needed for Groups/Support.
# The assistant only sees what this Taskflow user is permitted to see.
TASKFLOW_API_TOKEN=
TASKFLOW_EMAIL=
TASKFLOW_PASSWORD=

# Mobile alerts — the Taskflow user above needs Monitor read (+ alert manage) permissions.
# PA polls Atrium Monitor and sends Expo pushes to registered phones every N seconds (min 30).
MONITOR_WATCH_INTERVAL_SEC=60

# Control center
PA_ADMIN_SECRET=
CONTROL_CENTER_ORIGIN=http://localhost:5174
# Comma-separated extra browser origins allowed by CORS (production should list only real UIs)
# CONTROL_CENTER_ORIGIN_ALLOWLIST=https://pa.example.com,https://cc.example.com

# Agent workspace path jail (required in production / when AGENT_WORKSPACE_ROOTS_REQUIRED=true)
# AGENT_WORKSPACE_ROOTS=/home/dev/projects,/var/repos
# AGENT_WORKSPACE_ROOTS_REQUIRED=true

# -- WhatsApp reliability -------------------------------------------------------
# Restart the browser if WhatsApp authenticates but never becomes ready (seconds).
# WA_READY_TIMEOUT_SEC=120

# -- Broadcasts -------------------------------------------------------------------
# Pace and cap bulk sends to protect the number from WhatsApp spam detection.
# BROADCAST_INTERVAL_SEC=8
# BROADCAST_MAX_RECIPIENTS=200

# -- Per-user admin access (instead of sharing PA_ADMIN_SECRET) ------------------
# Clients may send an Atrium token (personal atr_… token or session) as a Bearer token.
# Allowed when the Atrium user has this permission, or their email is listed below.
# PA_ADMIN_PERMISSION=taskflow.service.ticket.update
# PA_ADMIN_EMAILS=you@company.com,ops@company.com
