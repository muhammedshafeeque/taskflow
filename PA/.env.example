PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pa
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Strong model: QA tickets, polished customer replies, hard DMs
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Fast/cheap model: triage, SE decide JSON, reply critic, uncertain DM classify
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=ml
# Optional overrides
SUPPORT_CHAT_MODEL=
SUPPORT_STRONG_MODEL=
SUPPORT_FAST_MODEL=
# Fail fast on slow Groq calls (SDK retries 429/5xx twice)
GROQ_TIMEOUT_MS=30000

# WhatsApp bot tuning
# Quiet window to merge a message burst into one reply, and max hold time
BOT_BATCH_WINDOW_MS=1200
BOT_BATCH_MAX_WAIT_MS=4000
# Chats processed in parallel (protects Groq rate limits)
BOT_MAX_CONCURRENT_CHATS=4
# Ignore backlog older than this after reconnects (0 = never skip)
BOT_MAX_MESSAGE_AGE_SEC=600
# Show "typing…"/"recording…" and mark chats read while working
BOT_TYPING_INDICATOR=true

# Taskflow — TASKFLOW_INGEST_SECRET = server PA_INGEST_SECRET
# Used for: CRM leads, Groups project list, Service Desk tickets, project context,
# portal service-request approve/reject via Control Center.
TASKFLOW_API_URL=http://127.0.0.1:5000
TASKFLOW_INGEST_SECRET=
TASKFLOW_ORG_ID=
TASKFLOW_TIMEOUT_MS=8000
# Optional: JWT for fuller Atrium dashboard snapshot (not needed for Groups/Support).
TASKFLOW_API_TOKEN=
TASKFLOW_EMAIL=
TASKFLOW_PASSWORD=

# Control center
PA_ADMIN_SECRET=
CONTROL_CENTER_ORIGIN=http://localhost:5174

# Optional: comma-separated absolute roots for agent workspace path jail
# AGENT_WORKSPACE_ROOTS=/home/dev/projects,/var/repos
