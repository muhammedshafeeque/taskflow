# App identity (used by app.config.ts at build time)
APP_NAME=PA Control
APP_BRAND_NAME=PA Control
APP_PACKAGE=com.example.pacontrol
EAS_PROJECT_ID=
# Default server URLs (users can change the PA URL on the unlock screen)
EXPO_PUBLIC_PA_API_URL=https://pa.example.com
EXPO_PUBLIC_ATRIUM_URL=https://atrium.example.com
# Android push needs a Firebase google-services.json (path relative to this folder)
GOOGLE_SERVICES_FILE=
