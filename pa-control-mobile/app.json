{
  "expo": {
    "name": "Ivorix PA Control",
    "slug": "pa-control-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pacontrol",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.repod.pacontrol"
    },
    "android": {
      "package": "online.repod.pacontrol",
      "adaptiveIcon": {
        "backgroundColor": "#0f1218",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f1218"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "paApiUrl": "https://pa.repod.online",
      "atriumUrl": "https://taskflow.repod.online",
      "eas": {
        "projectId": "pa-control-mobile-local"
      }
    }
  }
}
