{
  "expo": {
    "name": "Ivorix PA Control",
    "slug": "pa-control-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pacontrol",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.repod.pacontrol",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used for voice commands to the PA assistant.",
        "NSFaceIDUsageDescription": "Unlock PA Control with Face ID.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "online.repod.pacontrol",
      "adaptiveIcon": {
        "backgroundColor": "#090C13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090C13"
        }
      ],
      "expo-background-task",
      [
        "expo-audio",
        {
          "microphonePermission": "Used for voice commands to the PA assistant."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C8CFF",
          "defaultChannel": "alerts"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock PA Control with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "paApiUrl": "https://pa.repod.online",
      "atriumUrl": "https://taskflow.repod.online",
      "eas": {
        "projectId": "pa-control-mobile-local"
      }
    }
  }
}
