VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
# Optional: browser push key (otherwise fetched from the API)
VITE_VAPID_PUBLIC_KEY=

# Self-report this SPA into Monitor (OFF by default — key is public in the bundle).
# Prefer server MONITOR_KEY. Set VITE_MONITOR_ENABLED=true only for intentional browser telemetry.
VITE_MONITOR_ENABLED=false
VITE_MONITOR_BASE_URL=
VITE_MONITOR_KEY=
VITE_MONITOR_RELEASE=

